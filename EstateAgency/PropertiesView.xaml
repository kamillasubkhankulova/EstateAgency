<UserControl x:Class="EstateAgency.PropertiesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Фильтры -->
        <Border Grid.Row="0" Background="#F5F7F9" Padding="12" CornerRadius="6">
            <WrapPanel Orientation="Horizontal">
                <TextBlock Text="Адрес:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox x:Name="AddressFilter" Width="220" Height="30"
                         Margin="0,0,16,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Тип:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox x:Name="TypeFilter" Width="150" Height="30"
                          Margin="0,0,16,0" SelectedIndex="0">
                    <ComboBoxItem Content="Все типы"/>
                    <ComboBoxItem Content="Квартира"/>
                    <ComboBoxItem Content="Дом"/>
                    <ComboBoxItem Content="Коммерция"/>
                </ComboBox>

                <Button Content="Найти" Width="100" Height="30"
                        Margin="0,0,8,0" Click="OnSearchClick"/>
                <Button Content="Сбросить" Width="100" Height="30"
                        Click="OnResetClick"/>
            </WrapPanel>
        </Border>

        <!-- Таблица -->
        <Border Grid.Row="1" Margin="0,12,0,0"
                BorderBrush="#DDE3E8" BorderThickness="1">
            <DataGrid x:Name="PropertiesGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      RowHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="50"/>
                    <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="*"/>
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeTitle}" Width="110"/>
                    <DataGridTextColumn Header="Площадь" Binding="{Binding Area, StringFormat={}{0:N1}}" Width="90"/>
                    <DataGridTextColumn Header="Комнаты" Binding="{Binding Rooms}" Width="80"/>
                    <DataGridTextColumn Header="Этаж" Binding="{Binding Floor}" Width="60"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, StringFormat={}{0:N0} ₽}" Width="130"/>
                    <DataGridTextColumn Header="Статус" Binding="{Binding StateTitle}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
            <Button Content="Добавить" Width="120" Height="34"
                    Margin="0,0,8,0" Click="OnAddClick"/>
            <Button Content="Редактировать" Width="130" Height="34"
                    Margin="0,0,8,0" Click="OnEditClick"/>
            <Button Content="Удалить" Width="120" Height="34"
                    Click="OnDeleteClick"/>
        </StackPanel>
    </Grid>
</UserControl>