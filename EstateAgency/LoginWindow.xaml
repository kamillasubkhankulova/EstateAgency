<Window x:Class="EstateAgency.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Вход — Риелторское агентство"
        Height="470" Width="430"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid Background="#F2F5F8">
        <Border Width="360" Padding="28" Background="White" CornerRadius="8"
                VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.12" Color="Black"/>
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Риелторское агентство"
                           FontSize="19" FontWeight="SemiBold" Foreground="#1B2B3A"/>
                <TextBlock Text="Вход в систему"
                           FontSize="13" Foreground="#78909C" Margin="0,4,0,0"/>

                <TextBlock Text="Логин" Margin="0,22,0,6" FontSize="13" Foreground="#37474F"/>
                <TextBox x:Name="LoginTextBox" Height="36" Padding="8,0"
                         VerticalContentAlignment="Center" FontSize="14"/>

                <TextBlock Text="Пароль" Margin="0,14,0,6" FontSize="13" Foreground="#37474F"/>
                <PasswordBox x:Name="PasswordInput" Height="36" Padding="8,0"
                             VerticalContentAlignment="Center" FontSize="14"/>

                <Button Content="Войти" Height="40" Margin="0,22,0,0"
                        Click="OnLoginClick" IsDefault="True"
                        Background="#1565C0" Foreground="White"
                        FontSize="14" FontWeight="SemiBold"/>

                <Button Content="Выход" Height="36" Margin="0,10,0,0"
                        Click="OnExitClick" IsCancel="True" FontSize="13"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>