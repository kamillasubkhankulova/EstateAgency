<Window x:Class="EstateAgency.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Риелторское агентство"
        Height="700" Width="1100"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Верхняя панель -->
        <Border Grid.Row="0" Background="#1565C0" Padding="18,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Риелторское агентство"
                           Foreground="White" FontSize="16" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,18,0" VerticalAlignment="Center">
                        <TextBlock x:Name="UserFullNameText" Foreground="White"
                                   FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Right"/>
                        <TextBlock x:Name="UserRoleText" Foreground="#CFE0F0"
                                   FontSize="12" HorizontalAlignment="Right"/>
                    </StackPanel>

                    <Button Content="Выйти из аккаунта" Padding="12,6"
                            Click="OnLogoutClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#ECEFF1" Padding="14">
                <StackPanel>
                    <TextBlock Text="Разделы" FontSize="13" FontWeight="SemiBold"
                               Foreground="#607D8B" Margin="0,0,0,12"/>

                    <Button Content="Объекты" Height="38" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left" Padding="12,0"
                            Click="OnPropertiesClick"/>

                    <Button Content="Клиенты" Height="38" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left" Padding="12,0"
                            Click="OnClientsClick"/>

                    <Button Content="Сделки" Height="38" Margin="0,0,0,8"
                            HorizontalContentAlignment="Left" Padding="12,0"
                            Click="OnDealsClick"/>

                    <Button Content="Отчёты" Height="38"
                            HorizontalContentAlignment="Left" Padding="12,0"
                            Click="OnReportsClick"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="White">
                <Grid>
                    <ContentControl x:Name="ContentHost"/>

                    <StackPanel x:Name="WelcomePanel"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Выберите раздел в меню слева"
                                   FontSize="18" Foreground="#607D8B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="WelcomeText" FontSize="13" Foreground="#90A4AE"
                                   Margin="0,8,0,0" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>